{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/context.sh\" SessionStart 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/context.sh\" PostCompact 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/snapshot.sh\" precompact >/dev/null 2>&1; printf '{\"systemMessage\":\"Context is full. Working tree snapshotted to refs/snapshots/ before compaction.\"}'",
            "timeout": 30,
            "statusMessage": "Snapshotting before compaction..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/scripts/snapshot.sh\" edit >/dev/null 2>&1 || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
